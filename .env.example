# Frontend env (used at build time)
# Leave empty when using Vercel API proxy (recommended for Vercel deploy)
# VITE_API_URL=

# If frontend calls backend directly (no Vercel proxy):
# VITE_API_URL=https://your-backend.onrender.com

# Vercel serverless — set in Vercel dashboard (NOT in .env file):
# BACKEND_URL=https://your-backend.onrender.com
